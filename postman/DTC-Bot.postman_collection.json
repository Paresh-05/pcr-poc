{
  "info": {
    "name": "DTC Bot",
    "description": "Run in order: 3 starts a conversation and saves its id, 4 and 5 use it. Set api_key in the DTC Bot Local environment (copy API_KEY from .env). Request 3 takes about a minute the first time for a DTC with many cases, then is fast.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health (public)",
      "request": { "method": "GET", "url": "{{base_url}}/health" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 ok', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"
      ] } }]
    },
    {
      "name": "2. Health DB (needs key)",
      "request": { "method": "GET", "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }], "url": "{{base_url}}/health/db" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 and cases loaded', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().cases).to.be.above(0); });"
      ] } }]
    },
    {
      "name": "3. Start conversation (DTC + model)",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"dtc_code\": \"P0049F1\",\n  \"model_line\": \"GLOSTER\"\n}" },
        "url": "{{base_url}}/conversations"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const d = pm.response.json();",
        "pm.test('201 created', () => pm.response.to.have.status(201));",
        "pm.test('has evidence', () => { pm.expect(d.evidence.total_cases).to.be.above(0); pm.expect(['dtc_and_model','dtc_all_models','none']).to.include(d.evidence.scope); });",
        "pm.test('AI opening turn', () => { pm.expect(d.turn.reply.length).to.be.above(0); pm.expect(['asking','concluded']).to.include(d.turn.state); });",
        "pm.collectionVariables.set('conversation_id', d.conversation_id);"
      ] } }]
    },
    {
      "name": "4. Send message (technician answer)",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"The actuator moves normally and does not stick. Wiring and connector look fine.\"\n}" },
        "url": "{{base_url}}/conversations/{{conversation_id}}/messages"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const d = pm.response.json();",
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('AI replied with causes/checks', () => { pm.expect(d.turn.reply.length).to.be.above(0); pm.expect(d.turn.likely_causes).to.be.an('array'); pm.expect(d.turn.next_checks).to.be.an('array'); });"
      ] } }]
    },
    {
      "name": "5. Get conversation history",
      "request": { "method": "GET", "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }], "url": "{{base_url}}/conversations/{{conversation_id}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const d = pm.response.json();",
        "pm.test('200 with messages', () => { pm.response.to.have.status(200); pm.expect(d.messages.length).to.be.at.least(2); });",
        "pm.test('internal opening prompt is hidden', () => pm.expect(d.messages[0].role).to.eql('assistant'));"
      ] } }]
    },
    {
      "name": "6. Negative - no API key (expect 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"dtc_code\": \"P0049F1\",\n  \"model_line\": \"GLOSTER\"\n}" },
        "url": "{{base_url}}/conversations"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] } }]
    },
    {
      "name": "7. Negative - bad DTC / extra field (expect 422)",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"dtc_code\": \"x\",\n  \"model_line\": \"GLOSTER\",\n  \"is_admin\": true\n}" },
        "url": "{{base_url}}/conversations"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('422', () => pm.response.to.have.status(422));"] } }]
    },
    {
      "name": "8. Negative - unknown conversation (expect 404)",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"hello\"\n}" },
        "url": "{{base_url}}/conversations/00000000-0000-0000-0000-000000000000/messages"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('404', () => pm.response.to.have.status(404));"] } }]
    }
  ],
  "variable": [{ "key": "conversation_id", "value": "" }]
}
